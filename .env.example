# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inbox
DATABASE_URL=postgres://inbox:change-me@localhost:5434/inbox

# Azure app registration (personal Microsoft accounts)
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:3000/api/auth/callback

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Langflow (tri IA)
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=

# Google (Gmail)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
